{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "buildproof",
  "main": "cloudflare/worker.js",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "buildproof.eunryong.com/*",
      "zone_name": "eunryong.com"
    }
  ],
  "compatibility_date": "2026-10-11",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "buildproof",
      "database_id": "8f75b7f6-2576-44ba-a760-d7510916e371",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "PUBLIC_DEMO_MODE": "1",
    "GEMINI_MODEL": "gemini-3.8-flash",
    "SOLANA_RPC_URL": "https://api.devnet.solana.com"
  },
  "secrets": {
    "required": ["GEMINI_API_KEY", "BUILDPROOF_SESSION_SECRET"]
  }
}
