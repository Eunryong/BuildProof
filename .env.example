GEMINI_API_KEY=add_your_google_ai_studio_key_here
GEMINI_MODEL=gemini-3.8-flash
# Keep the provider URL and API key on the server. Helius Devnet format:
# https://devnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY
SOLANA_RPC_URL=https://api.devnet.solana.com
# Optional for local Express demo isolation. The hosted Worker uses Cloudflare D1 instead.
# For local Wrangler emulation, keep Worker secrets in the ignored .dev.vars file.
# PUBLIC_DEMO_MODE=1
# BUILDPROOF_DATA_DIR=/private/path/to/buildproof-public-data
# BUILDPROOF_SESSION_SECRET=replace_with_at_least_32_random_characters
